# Go-Ye local development only. Copy this file to .env before `docker compose up --build`.
# Never reuse these placeholder values in a shared, staging, or production environment.
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# Docker PostgreSQL development database. These are deliberately non-production values.
POSTGRES_DB=goye
POSTGRES_USER=goye_app
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Direct local API use outside Docker (the compose API injects its service hostname itself).
DATABASE_URL=postgresql://goye_app:replace-with-a-local-development-password@localhost:5432/goye
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Reserve these values for the security/authentication phase. Generate unique 32-byte base64 values;
# never commit real keys or inject production secrets into a developer machine configuration file.
JWT_ACCESS_SECRET=replace-with-32-byte-base64-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-base64-secret
PII_ENCRYPTION_KEY=replace-with-32-byte-base64-data-encryption-key
PII_LOOKUP_PEPPER=replace-with-a-distinct-32-byte-lookup-pepper
AUDIT_CHAIN_SECRET=replace-with-32-byte-base64-hmac-key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_PEPPER=replace-with-a-32-byte-base64-otp-pepper
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_SEND_LIMIT_PER_PHONE_PER_HOUR=3
OTP_SEND_LIMIT_PER_IP_PER_HOUR=10

# Optional integrations remain off until church-owned accounts, consent workflows and hard caps are approved.
SMS_PROVIDER=disabled
SMS_MONTHLY_HARD_CAP=0
WHATSAPP_PROVIDER=disabled
WHATSAPP_MONTHLY_HARD_CAP=0
ALLOW_SAMPLE_SEED=false

# Durable follow-up task/retry queue polling. Each replica may safely run this because
# database uniqueness and row claims prevent duplicate reminder jobs.
FOLLOW_UP_SCHEDULER_ENABLED=true
FOLLOW_UP_SCHEDULER_INTERVAL_SECONDS=60
FOLLOW_UP_TIME_ZONE=Africa/Lagos

# FCM stays disabled until church-owned Firebase credentials are injected by the
# deployment secret store. Service-account JSON must never be committed.
FCM_ENABLED=false
FCM_DELIVERY_INTERVAL_SECONDS=30
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
