# Go-Ye server configuration. Copy to .env locally; never commit actual values.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database: use a least-privilege application account, TLS in production.
DATABASE_URL=postgresql://goye_app:change-me@localhost:5432/goye
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Cryptography. Generate 32-byte base64 keys with the documented bootstrap command.
JWT_ACCESS_SECRET=replace-with-32-byte-base64-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-base64-secret
PII_ENCRYPTION_KEY=replace-with-32-byte-base64-data-encryption-key
AUDIT_CHAIN_SECRET=replace-with-32-byte-base64-hmac-key

# Authentication, abuse prevention and trusted app origins.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_SEND_LIMIT_PER_PHONE_PER_HOUR=3
CORS_ORIGINS=http://localhost:3000

# Optional integrations. Leave disabled until church-owned accounts and monthly caps are approved.
SMS_PROVIDER=disabled
SMS_MONTHLY_HARD_CAP=0
WHATSAPP_PROVIDER=disabled
WHATSAPP_MONTHLY_HARD_CAP=0
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Object storage for tract media. Use church-owned credentials in deployment.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
